<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_micro_flow_member" model="ir.sequence">
            <field name="name">Séquence Membre Micro Flow</field>
            <field name="code">micro.flow.member.order</field>
            <field name="prefix">MF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_micro_transaction" model="ir.sequence">
            <field name="name">Séquence Transaction Micro Flow</field>
            <field name="code">micro.transaction</field>
            <field name="prefix">MF-TX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>