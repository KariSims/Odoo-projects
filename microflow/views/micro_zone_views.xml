<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_micro_zone_list" model="ir.ui.view">
        <field name="name">micro.zone.list</field>
        <field name="model">micro.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="commission_rate" widget="percentage"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_micro_zone_form" model="ir.ui.view">
        <field name="name">micro.zone.form</field>
        <field name="model">micro.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"
                                   domain="[('id', '!=', id)]"
                                   options="{'no_create': True}"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="complete_name" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sous-zones" invisible="not child_ids">
                            <field name="child_ids" nolabel="1">
                                <list create="0">
                                    <field name="complete_name" string="Zone"/>
                                    <field name="code"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_micro_zone" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="res_model">micro.zone</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_micro_zone_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_micro_zone_form')})
        ]"/>
    </record>
</odoo>
