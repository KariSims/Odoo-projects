<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         LIST VIEW (agents + managers)
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_micro_transaction_list" model="ir.ui.view">
        <field name="name">micro.transaction.list</field>
        <field name="model">micro.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-info="state == 'draft'">
                <header>
                    <button name="action_bulk_confirm" type="object"
                            string="Tout Valider" class="btn-primary"
                            groups="microflow.group_micro_flow_manager"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agent_id"/>
                <field name="transaction_type" widget="badge"/>
                <field name="amount" sum="Total Collecté"/>
                <field name="commission_amount" optional="hide" sum="Total Commissions"/>
                <field name="net_amount" sum="Total Net" optional="hide"/>
                <field name="is_verified" widget="boolean_toggle"
                       groups="microflow.group_micro_flow_manager"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         KANBAN DASHBOARD (manager — groupé par agent)
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_micro_transaction_kanban" model="ir.ui.view">
        <field name="name">micro.transaction.kanban.dashboard</field>
        <field name="model">micro.transaction</field>
        <field name="arch" type="xml">
            <kanban default_group_by="agent_id" class="mf-manager-kanban"
                    quick_create="false" group_create="false">
                <field name="agent_id"/>
                <field name="partner_id"/>
                <field name="amount" group_operator="sum"/>
                <field name="transaction_type"/>
                <field name="is_verified"/>
                <field name="state"/>
                <field name="currency_id"/>
                <progressbar field="is_verified"
                             colors='{"true": "success", "false": "warning"}'
                             sum_field="amount"/>
                <templates>
                    <t t-name="card">
                        <div class="mf-tx-card">
                            <!-- Membre + type -->
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                                <span class="fw-bold text-truncate">
                                    <field name="partner_id"/>
                                </span>
                                <field name="transaction_type" widget="badge" class="flex-shrink-0"/>
                            </div>
                            <!-- Montant -->
                            <div class="mf-tx-amount fs-5 fw-bold text-primary my-2">
                                <field name="amount" widget="monetary"/>
                            </div>
                            <!-- Validation manager -->
                            <div class="d-flex align-items-center gap-2 mt-auto">
                                <field name="is_verified" widget="boolean_toggle"
                                       groups="microflow.group_micro_flow_manager"/>
                                <span class="text-muted small"
                                      t-if="record.is_verified.value">Fonds reçus ✓</span>
                                <span class="text-muted small"
                                      t-if="!record.is_verified.value">À vérifier</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_micro_transaction_form" model="ir.ui.view">
        <field name="name">micro.transaction.form</field>
        <field name="model">micro.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_bulk_confirm" string="Valider"
                            type="object" class="oe_highlight"
                            groups="microflow.group_micro_flow_manager"
                            invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="agent_id"/>
                            <field name="transaction_type"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="commission_amount"/>
                            <field name="net_amount"/>
                            <field name="currency_id"/>
                            <field name="journal_id"/>
                            <field name="is_verified" groups="microflow.group_micro_flow_manager"/>
                        </group>
                    </group>
                    <group string="Comptabilité" groups="microflow.group_micro_flow_manager"
                           invisible="move_id == False">
                        <field name="move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ACTIONS
    ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Tableau de Bord Manager : client action OWL (transactions + crédits) -->
    <record id="action_manager_dashboard" model="ir.actions.client">
        <field name="name">Tableau de Bord</field>
        <field name="tag">microflow.manager_dashboard</field>
    </record>

    <!-- Action act_window conservée pour accès direct / bookmarks -->
    <record id="action_micro_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de Bord</field>
        <field name="res_model">micro.transaction</field>
        <field name="view_mode">list,kanban</field>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{'group_by': 'agent_id', 'search_default_draft': 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_micro_transaction_kanban')}),
            (0, 0, {'view_mode': 'list',   'view_id': ref('view_micro_transaction_list')})
        ]"/>
    </record>

    <!-- Récapitulatif journalier agent -->
    <record id="action_micro_transaction_recap" model="ir.actions.act_window">
        <field name="name">Mon Récapitulatif du Jour</field>
        <field name="res_model">micro.transaction</field>
        <field name="view_mode">list</field>
        <field name="domain">[
            ('agent_id', '=', uid),
            ('state', '=', 'draft'),
            ('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))
        ]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_micro_transaction_list')})
        ]"/>
    </record>

    <!-- Toutes les transactions (manager) -->
    <record id="action_micro_transaction_all" model="ir.actions.act_window">
        <field name="name">Toutes les Transactions</field>
        <field name="res_model">micro.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_micro_transaction_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_micro_transaction_form')})
        ]"/>
    </record>
</odoo>
