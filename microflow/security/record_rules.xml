<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         micro.cycle
         Agent → voit uniquement ses propres cycles (agent_id = user)
         Manager → voit tout (OR avec la règle agent grâce à implied_ids)
    ═══════════════════════════════════════════════════════════════════════════ -->
    <record id="rule_micro_cycle_agent_own" model="ir.rule">
        <field name="name">Cycle: agent voit ses propres cycles</field>
        <field name="model_id" ref="model_micro_cycle"/>
        <field name="domain_force">[('agent_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('microflow.group_micro_flow_agent'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_micro_cycle_manager_all" model="ir.rule">
        <field name="name">Cycle: manager voit tout</field>
        <field name="model_id" ref="model_micro_cycle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('microflow.group_micro_flow_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

