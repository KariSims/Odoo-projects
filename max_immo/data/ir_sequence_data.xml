<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_max_immo_property" model="ir.sequence">
            <field name="name">MaxImmo - Référence Propriété</field>
            <field name="code">max.immo.property</field>
            <field name="prefix">PROP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_max_immo_occupation" model="ir.sequence">
            <field name="name">MaxImmo - Référence Occupation</field>
            <field name="code">max.immo.occupation</field>
            <field name="prefix">OCC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_max_immo_payment" model="ir.sequence">
            <field name="name">MaxImmo - Référence Règlement</field>
            <field name="code">max.immo.payment</field>
            <field name="prefix">PAY/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
