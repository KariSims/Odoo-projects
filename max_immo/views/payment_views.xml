<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== FORM VIEW ===== -->
    <record id="view_max_immo_payment_form" model="ir.ui.view">
        <field name="name">max.immo.payment.form</field>
        <field name="model">max.immo.payment</field>
        <field name="arch" type="xml">
            <form string="Règlement">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirmer"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object"
                            string="Annuler le règlement"
                            invisible="state != 'confirmed'"
                            groups="max_immo.group_max_immo_manager"
                            confirm="Annuler ce règlement ? Si lié à une facture, elle sera remise en attente."/>
                    <button name="action_reset_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state != 'cancelled'"
                            groups="max_immo.group_max_immo_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <!-- Colonne gauche : qui paie quoi -->
                        <group string="Règlement">
                            <field name="partner_id"
                                   readonly="state == 'confirmed'"
                                   required="1"
                                   options="{'no_create': True}"
                                   placeholder="Rechercher un locataire / partenaire…"/>
                            <field name="payment_type"
                                   readonly="state == 'confirmed'"/>
                            <field name="amount"
                                   readonly="state == 'confirmed'"/>
                            <field name="period_label"
                                   placeholder="Ex: Loyer Mars 2026…"/>
                        </group>

                        <!-- Colonne droite : quand et comment -->
                        <group string="Date, heure et mode">
                            <field name="payment_datetime"
                                   readonly="state == 'confirmed'"/>
                            <field name="payment_day" readonly="1"/>
                            <field name="payment_method"
                                   readonly="state == 'confirmed'"/>
                            <field name="reference_ext"
                                   placeholder="N° reçu, bordereau, chèque…"/>
                        </group>
                    </group>

                    <group>
                        <!-- Colonne gauche : contexte -->
                        <group string="Contexte">
                            <field name="property_id" readonly="1"/>
                            <field name="room_id" readonly="1"/>
                            <field name="occupation_id"
                                   readonly="state == 'confirmed'"
                                   domain="[('tenant_id', '=', partner_id)]"/>
                            <field name="bill_id"
                                   readonly="state == 'confirmed'"/>
                        </group>

                        <!-- Colonne droite : enregistrement -->
                        <group string="Enregistrement">
                            <field name="confirmed_by" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>

                    <group string="Observations">
                        <field name="notes" nolabel="1"
                               placeholder="Notes internes…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== LIST VIEW — CHRONOLOGIQUE ===== -->
    <record id="view_max_immo_payment_list" model="ir.ui.view">
        <field name="name">max.immo.payment.list</field>
        <field name="model">max.immo.payment</field>
        <field name="arch" type="xml">
            <list string="Règlements"
                  default_order="payment_datetime desc"
                  decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'draft'">
                <field name="reference"/>
                <!-- Date et heure exactes -->
                <field name="payment_datetime" string="Date / Heure"/>
                <field name="payment_day"     string="Jour" optional="show"/>
                <field name="payment_month"   string="Mois" optional="show"/>
                <!-- Qui -->
                <field name="partner_id"       string="Locataire / Partenaire"/>
                <!-- Quoi -->
                <field name="payment_type"
                       widget="badge"
                       decoration-info="payment_type == 'rent'"
                       decoration-warning="payment_type == 'deposit'"
                       decoration-secondary="payment_type == 'charge'"/>
                <field name="period_label"     optional="show"/>
                <field name="amount"           string="Montant (FCFA)"/>
                <!-- Comment -->
                <field name="payment_method"
                       widget="badge"
                       optional="show"/>
                <field name="reference_ext"    optional="show"/>
                <!-- Contexte -->
                <field name="property_id"      optional="show"/>
                <field name="room_id"          optional="show"/>
                <field name="occupation_id"    optional="show"/>
                <field name="bill_id"          optional="show"/>
                <!-- État -->
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="view_max_immo_payment_search" model="ir.ui.view">
        <field name="name">max.immo.payment.search</field>
        <field name="model">max.immo.payment</field>
        <field name="arch" type="xml">
            <search string="Rechercher un règlement">
                <field name="reference"/>
                <field name="partner_id"    string="Locataire / Partenaire"/>
                <field name="room_id"       string="Chambre"/>
                <field name="property_id"   string="Propriété"/>
                <field name="occupation_id" string="Occupation"/>
                <field name="reference_ext" string="Réf. externe"/>
                <separator/>
                <!-- Filtres par état -->
                <filter string="Confirmés"  name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Brouillons" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Annulés"    name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <!-- Filtres par type -->
                <filter string="Loyers"     name="rent"
                        domain="[('payment_type', '=', 'rent')]"/>
                <filter string="Cautions"   name="deposit"
                        domain="[('payment_type', '=', 'deposit')]"/>
                <filter string="Charges"    name="charge"
                        domain="[('payment_type', '=', 'charge')]"/>
                <separator/>
                <!-- Filtres temporels -->
                <filter string="Aujourd'hui" name="today"
                        domain="[('payment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Ce mois"     name="this_month"
                        domain="[('payment_month', '=', context_today().strftime('%m/%Y'))]"/>
                <filter string="Mois dernier" name="last_month"
                        domain="[('payment_month', '=', (context_today() + relativedelta(months=-1)).strftime('%m/%Y'))]"/>
                <!-- Regroupements -->
                <group expand="1" string="Regrouper par">
                    <filter string="Locataire / Partenaire" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Propriété"              name="group_property"
                            context="{'group_by': 'property_id'}"/>
                    <filter string="Chambre"                name="group_room"
                            context="{'group_by': 'room_id'}"/>
                    <filter string="Type de règlement"      name="group_type"
                            context="{'group_by': 'payment_type'}"/>
                    <filter string="Mode de paiement"       name="group_method"
                            context="{'group_by': 'payment_method'}"/>
                    <filter string="Mois"                   name="group_month"
                            context="{'group_by': 'payment_datetime:month'}"/>
                    <filter string="Jour du mois"           name="group_day"
                            context="{'group_by': 'payment_day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== GRAPH VIEW ===== -->
    <record id="view_max_immo_payment_graph" model="ir.ui.view">
        <field name="name">max.immo.payment.graph</field>
        <field name="model">max.immo.payment</field>
        <field name="arch" type="xml">
            <graph string="Règlements" type="bar">
                <field name="partner_id"       type="row"/>
                <field name="payment_datetime" type="col" interval="month"/>
                <field name="amount"           type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===== PIVOT VIEW ===== -->
    <record id="view_max_immo_payment_pivot" model="ir.ui.view">
        <field name="name">max.immo.payment.pivot</field>
        <field name="model">max.immo.payment</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Règlements">
                <field name="partner_id"    type="row"/>
                <field name="property_id"   type="row"/>
                <field name="payment_datetime" type="col" interval="month"/>
                <field name="amount"        type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===== ACTIONS ===== -->
    <record id="action_max_immo_payment_all" model="ir.actions.act_window">
        <field name="name">Tous les Règlements</field>
        <field name="res_model">max.immo.payment</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_max_immo_payment_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun règlement enregistré
            </p>
        </field>
    </record>

    <record id="action_max_immo_payment_by_partner" model="ir.actions.act_window">
        <field name="name">Règlements par Locataire</field>
        <field name="res_model">max.immo.payment</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_max_immo_payment_search"/>
        <field name="context">{
            'search_default_confirmed': 1,
            'search_default_group_partner': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun règlement enregistré
            </p>
        </field>
    </record>

</odoo>
