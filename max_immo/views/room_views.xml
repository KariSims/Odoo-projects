<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== FORM VIEW ===== -->
    <record id="view_max_immo_room_form" model="ir.ui.view">
        <field name="name">max.immo.room.form</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <form string="Chambre / Unité">
                <header>
                    <button name="action_new_occupation" type="object"
                            string="Nouvelle Occupation"
                            class="btn-primary"
                            invisible="state != 'available'"/>
                    <button name="action_new_bill" type="object"
                            string="Ajouter une Facture"
                            class="btn-secondary"/>
                    <button name="action_set_available" type="object"
                            string="Marquer Disponible"
                            invisible="state == 'available'"
                            groups="max_immo.group_max_immo_manager"/>
                    <button name="action_set_reserved" type="object"
                            string="Réserver"
                            invisible="state != 'available'"
                            groups="max_immo.group_max_immo_user"/>
                    <button name="action_set_maintenance" type="object"
                            string="Mettre en Maintenance"
                            invisible="state == 'maintenance'"
                            groups="max_immo.group_max_immo_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,occupied,maintenance"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">

                        <!-- Occupations -->
                        <button name="action_view_occupations" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="occupation_count"/>
                                </span>
                                <span class="o_stat_text">Occupations</span>
                            </div>
                        </button>

                        <!-- Factures en attente -->
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="pending_bills_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="pending_bills_count"/>
                                </span>
                                <span class="o_stat_text">Factures</span>
                            </div>
                        </button>

                        <!-- Factures en retard -->
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="overdue_bills_count == 0">
                            <div class="o_field_widget o_stat_info text-danger">
                                <span class="o_stat_value text-danger">
                                    <field name="overdue_bills_count"/>
                                </span>
                                <span class="o_stat_text">En retard</span>
                            </div>
                        </button>

                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Numéro ou nom de la pièce..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations">
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                            <field name="area"/>
                            <field name="rent_price"/>
                        </group>
                        <group string="Occupation actuelle">
                            <field name="state" invisible="1"/>
                            <field name="current_tenant_id"
                                   invisible="state != 'occupied'"/>
                            <field name="occupation_start_date"
                                   invisible="state != 'occupied'"/>
                            <field name="occupation_duration_days"
                                   string="Durée occupation (jours)"
                                   invisible="state != 'occupied'"/>
                            <field name="last_vacated_date"
                                   invisible="state == 'occupied'"/>
                            <field name="days_since_vacant"
                                   string="Inoccupée depuis (jours)"
                                   invisible="state == 'occupied'"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Onglet Factures / Charges -->
                        <page string="Factures / Charges" name="bills">
                            <field name="bill_ids"
                                   context="{'default_room_id': active_id}">
                                <list string="Factures"
                                      editable="bottom"
                                      decoration-danger="is_overdue == True"
                                      decoration-success="state == 'paid'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="bill_type_id" required="1"/>
                                    <field name="period_date" optional="show"/>
                                    <field name="reference" optional="show"/>
                                    <field name="amount"/>
                                    <field name="due_date" required="1"/>
                                    <field name="days_overdue" string="Retard (j)"
                                           decoration-danger="days_overdue &gt; 0"
                                           optional="show"/>
                                    <field name="days_until_due" string="Reste (j)"
                                           decoration-warning="days_until_due &lt;= 7 and days_until_due &gt; 0"
                                           optional="show"/>
                                    <field name="payment_date" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending' and not is_overdue"
                                           decoration-danger="is_overdue == True"
                                           decoration-success="state == 'paid'"
                                           decoration-muted="state == 'cancelled'"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <button name="action_mark_paid" type="object"
                                            string="Payer" icon="fa-check"
                                            invisible="state != 'pending'"
                                            class="btn-sm btn-success"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet Historique Occupations -->
                        <page string="Historique Occupations" name="history">
                            <field name="occupation_ids" readonly="1">
                                <list string="Occupations"
                                      decoration-success="state == 'active'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="reference"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="expected_end_date"/>
                                    <field name="actual_end_date"/>
                                    <field name="duration_days" string="Durée (j)"/>
                                    <field name="rent_amount"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-secondary="state == 'ended'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet Notes -->
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Description de la pièce..."/>
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== LIST VIEW ===== -->
    <record id="view_max_immo_room_list" model="ir.ui.view">
        <field name="name">max.immo.room.list</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <list string="Pièces / Unités"
                  decoration-success="state == 'available'"
                  decoration-danger="state == 'occupied'"
                  decoration-warning="state == 'reserved'"
                  decoration-info="state == 'maintenance'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="floor" optional="show"/>
                <field name="area" optional="show"/>
                <field name="rent_price"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'occupied'"
                       decoration-warning="state == 'reserved'"
                       decoration-info="state == 'maintenance'"/>
                <field name="current_tenant_id"/>
                <field name="occupation_start_date" optional="show"/>
                <field name="occupation_duration_days"
                       string="Jours occupée" optional="show"/>
                <field name="last_vacated_date" optional="show"/>
                <field name="days_since_vacant"
                       string="Jours libre" optional="show"/>
                <field name="pending_bills_count"
                       string="Factures" optional="show"/>
                <field name="overdue_bills_count"
                       string="En retard"
                       decoration-danger="overdue_bills_count &gt; 0"
                       optional="show"/>
            </list>
        </field>
    </record>

    <!-- ===== KANBAN VIEW ===== -->
    <record id="view_max_immo_room_kanban" model="ir.ui.view">
        <field name="name">max.immo.room.kanban</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="state"/>
                <field name="color"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="area"/>
                <field name="rent_price"/>
                <field name="current_tenant_id"/>
                <field name="occupation_start_date"/>
                <field name="occupation_duration_days"/>
                <field name="last_vacated_date"/>
                <field name="days_since_vacant"/>
                <field name="pending_bills_count"/>
                <field name="overdue_bills_count"/>
                <templates>
                    <t t-name="card" t-att-class="
                        record.state.raw_value == 'available' ? 'border-start border-success border-4' :
                        record.state.raw_value == 'occupied'  ? 'border-start border-danger border-4' :
                        record.state.raw_value == 'reserved'  ? 'border-start border-warning border-4' :
                        'border-start border-secondary border-4'
                    ">
                        <!-- En-tête : nom + état -->
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="fs-5">
                                <field name="name"/>
                            </strong>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'available'"
                                   decoration-danger="state == 'occupied'"
                                   decoration-warning="state == 'reserved'"
                                   decoration-secondary="state == 'maintenance'"/>
                        </div>

                        <!-- Propriété + type + étage -->
                        <div class="text-muted small mt-1">
                            <field name="property_id"/>
                            <t t-if="record.room_type_id.value">
                                · <field name="room_type_id"/>
                            </t>
                            <t t-if="record.floor.raw_value">
                                · Étage <field name="floor"/>
                            </t>
                        </div>

                        <!-- Infos occupation -->
                        <div class="mt-2">
                            <t t-if="record.state.raw_value == 'occupied'">
                                <div>
                                    <i class="fa fa-user me-1"/>
                                    <field name="current_tenant_id"/>
                                </div>
                                <div class="text-danger small">
                                    <i class="fa fa-clock-o me-1"/>
                                    Depuis <field name="occupation_start_date"/>
                                    (<field name="occupation_duration_days"/> j)
                                </div>
                            </t>
                            <t t-elif="record.state.raw_value == 'available'">
                                <div class="text-success small">
                                    <i class="fa fa-check me-1"/>
                                    <t t-if="record.days_since_vacant.raw_value">
                                        Libre depuis <field name="days_since_vacant"/> jours
                                    </t>
                                    <t t-else="">Jamais occupée</t>
                                </div>
                            </t>
                        </div>

                        <!-- Pied : surface + loyer + alerte factures -->
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <div>
                                <t t-if="record.area.raw_value">
                                    <span class="text-muted small me-2">
                                        <i class="fa fa-arrows-alt me-1"/>
                                        <field name="area"/> m²
                                    </span>
                                </t>
                                <t t-if="record.overdue_bills_count.raw_value &gt; 0">
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <field name="overdue_bills_count"/> en retard
                                    </span>
                                </t>
                                <t t-elif="record.pending_bills_count.raw_value &gt; 0">
                                    <span class="badge bg-light text-dark border">
                                        <i class="fa fa-file-text-o me-1"/>
                                        <field name="pending_bills_count"/> facture(s)
                                    </span>
                                </t>
                            </div>
                            <t t-if="record.rent_price.raw_value">
                                <span class="fw-bold">
                                    <field name="rent_price" widget="monetary"/>
                                </span>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="view_max_immo_room_search" model="ir.ui.view">
        <field name="name">max.immo.room.search</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <search string="Rechercher une pièce">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="current_tenant_id" string="Locataire (res.partner)"/>
                <separator/>
                <filter string="Disponibles" name="state_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="Occupées" name="state_occupied"
                        domain="[('state', '=', 'occupied')]"/>
                <filter string="Réservées" name="state_reserved"
                        domain="[('state', '=', 'reserved')]"/>
                <filter string="En Maintenance" name="state_maintenance"
                        domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter string="Avec factures en retard" name="has_overdue_bills"
                        domain="[('overdue_bills_count', '&gt;', 0)]"/>
                <filter string="Avec factures en attente" name="has_pending_bills"
                        domain="[('pending_bills_count', '&gt;', 0)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Propriété" name="group_property"
                            context="{'group_by': 'property_id'}"/>
                    <filter string="État" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Type de Pièce" name="group_type"
                            context="{'group_by': 'room_type_id'}"/>
                    <filter string="Étage" name="group_floor"
                            context="{'group_by': 'floor'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== GRAPH VIEW ===== -->
    <record id="view_max_immo_room_graph" model="ir.ui.view">
        <field name="name">max.immo.room.graph</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <graph string="Disponibilité des Pièces" type="bar">
                <field name="property_id" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ===== PIVOT VIEW ===== -->
    <record id="view_max_immo_room_pivot" model="ir.ui.view">
        <field name="name">max.immo.room.pivot</field>
        <field name="model">max.immo.room</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Pièces">
                <field name="property_id" type="row"/>
                <field name="room_type_id" type="row"/>
                <field name="state" type="col"/>
                <field name="rent_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="action_max_immo_room" model="ir.actions.act_window">
        <field name="name">Pièces / Unités</field>
        <field name="res_model">max.immo.room</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_max_immo_room_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune pièce configurée
            </p>
            <p>
                Créez une propriété et ajoutez ses pièces ou unités.
            </p>
        </field>
    </record>

</odoo>
