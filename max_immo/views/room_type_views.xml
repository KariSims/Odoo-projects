<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_max_immo_room_type_list" model="ir.ui.view">
        <field name="name">max.immo.room.type.list</field>
        <field name="model">max.immo.room.type</field>
        <field name="arch" type="xml">
            <list string="Types de Pièces" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="room_count" string="Nb. Pièces"/>
                <field name="color" widget="color_index"/>
            </list>
        </field>
    </record>

    <record id="view_max_immo_room_type_form" model="ir.ui.view">
        <field name="name">max.immo.room.type.form</field>
        <field name="model">max.immo.room.type</field>
        <field name="arch" type="xml">
            <form string="Type de Pièce">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_index"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="Description du type..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_max_immo_room_type" model="ir.actions.act_window">
        <field name="name">Types de Pièces</field>
        <field name="res_model">max.immo.room.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
