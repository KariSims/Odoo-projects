<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== FORM VIEW ===== -->
    <record id="view_max_immo_property_form" model="ir.ui.view">
        <field name="name">max.immo.property.form</field>
        <field name="model">max.immo.property</field>
        <field name="arch" type="xml">
            <form string="Propriété">
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">

                        <!-- Toutes les unités -->
                        <button name="action_view_rooms" type="object"
                                class="oe_stat_button" icon="fa-home">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_rooms"/>
                                </span>
                                <span class="o_stat_text">Unités</span>
                            </div>
                        </button>

                        <!-- Unités disponibles -->
                        <button name="action_view_rooms" type="object"
                                class="oe_stat_button" icon="fa-check-circle"
                                context="{'search_default_state_available': 1}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="available_rooms"/>
                                </span>
                                <span class="o_stat_text">Disponibles</span>
                            </div>
                        </button>

                        <!-- Occupations en cours -->
                        <button name="action_view_occupations" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="occupied_rooms"/>
                                </span>
                                <span class="o_stat_text">Occupées</span>
                            </div>
                        </button>

                        <!-- Factures en attente -->
                        <button name="action_view_bills" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="pending_bills_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="pending_bills_count"/>
                                </span>
                                <span class="o_stat_text">Factures</span>
                            </div>
                        </button>

                        <!-- Factures en retard — en rouge -->
                        <button name="action_view_overdue_bills" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="overdue_bills_count == 0">
                            <div class="o_field_widget o_stat_info text-danger">
                                <span class="o_stat_value text-danger">
                                    <field name="overdue_bills_count"/>
                                </span>
                                <span class="o_stat_text">En retard</span>
                            </div>
                        </button>

                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nom de la propriété..."/>
                        </h1>
                        <div class="text-muted">
                            <field name="reference" readonly="1"/>
                        </div>
                    </div>

                    <group>
                        <group string="Informations générales">
                            <field name="property_type"/>
                            <field name="owner_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Localisation">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>

                    <!-- Tableau de bord occupation -->
                    <group string="Tableau de bord — Occupation">
                        <group>
                            <field name="total_rooms"/>
                            <field name="available_rooms"/>
                            <field name="occupied_rooms"/>
                        </group>
                        <group>
                            <field name="reserved_rooms"/>
                            <field name="maintenance_rooms"/>
                            <field name="occupancy_rate" widget="percentage"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Onglet Pièces / Unités -->
                        <page string="Pièces / Unités" name="rooms">
                            <field name="room_ids" context="{'default_property_id': active_id}">
                                <list string="Pièces" editable="bottom"
                                      decoration-success="state == 'available'"
                                      decoration-danger="state == 'occupied'"
                                      decoration-warning="state == 'reserved'"
                                      decoration-info="state == 'maintenance'">
                                    <field name="name"/>
                                    <field name="room_type_id"/>
                                    <field name="floor"/>
                                    <field name="area" optional="show"/>
                                    <field name="rent_price"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-danger="state == 'occupied'"
                                           decoration-warning="state == 'reserved'"
                                           decoration-info="state == 'maintenance'"/>
                                    <field name="current_tenant_id"/>
                                    <field name="occupation_duration_days"
                                           string="Jours occupée" optional="show"/>
                                    <field name="days_since_vacant"
                                           string="Jours libre" optional="show"/>
                                    <field name="overdue_bills_count"
                                           string="Fact. retard"
                                           decoration-danger="overdue_bills_count &gt; 0"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet Factures de la propriété -->
                        <page string="Factures / Charges" name="bills">
                            <div class="mb-2">
                                <button string="Voir toutes les factures"
                                        name="action_view_bills"
                                        type="object"
                                        class="btn btn-sm btn-secondary"/>
                            </div>
                            <field name="room_ids" readonly="1">
                                <list string="Pièces avec factures en attente"
                                      decoration-danger="overdue_bills_count &gt; 0">
                                    <field name="name" string="Chambre"/>
                                    <field name="room_type_id" string="Type"/>
                                    <field name="current_tenant_id" string="Locataire"/>
                                    <field name="pending_bills_count" string="En attente"/>
                                    <field name="overdue_bills_count" string="En retard"
                                           decoration-danger="overdue_bills_count &gt; 0"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet Description -->
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description de la propriété..."/>
                        </page>

                        <!-- Onglet Photo -->
                        <page string="Photo" name="photo">
                            <field name="image" widget="image"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== LIST VIEW ===== -->
    <record id="view_max_immo_property_list" model="ir.ui.view">
        <field name="name">max.immo.property.list</field>
        <field name="model">max.immo.property</field>
        <field name="arch" type="xml">
            <list string="Propriétés"
                  decoration-muted="active == False"
                  decoration-danger="overdue_bills_count &gt; 0">
                <field name="reference" optional="show"/>
                <field name="name"/>
                <field name="property_type"/>
                <field name="city"/>
                <field name="owner_id"/>
                <field name="total_rooms"/>
                <field name="available_rooms" string="Dispo."/>
                <field name="occupied_rooms" string="Occupées"/>
                <field name="maintenance_rooms" string="Maint." optional="show"/>
                <field name="occupancy_rate" widget="percentage" string="Taux occup."/>
                <field name="pending_bills_count" string="Fact. en attente" optional="show"/>
                <field name="overdue_bills_count" string="Fact. en retard"
                       decoration-danger="overdue_bills_count &gt; 0"
                       optional="show"/>
                <field name="manager_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ===== KANBAN VIEW ===== -->
    <record id="view_max_immo_property_kanban" model="ir.ui.view">
        <field name="name">max.immo.property.kanban</field>
        <field name="model">max.immo.property</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="property_type"/>
                <field name="city"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="occupied_rooms"/>
                <field name="occupancy_rate"/>
                <field name="image"/>
                <field name="pending_bills_count"/>
                <field name="overdue_bills_count"/>
                <templates>
                    <t t-name="card" t-att-class="
                        record.overdue_bills_count.raw_value &gt; 0
                            ? 'border-top border-danger border-3'
                            : ''
                    ">
                        <div class="o_kanban_image">
                            <field name="image" widget="image" class="o_image_64_cover"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted small">
                                <field name="property_type"/> —
                                <field name="city"/>
                            </div>
                            <!-- Statistiques occupation -->
                            <div class="mt-1">
                                <span class="badge bg-success me-1">
                                    <field name="available_rooms"/> dispo.
                                </span>
                                <span class="badge bg-danger me-1">
                                    <field name="occupied_rooms"/> occupées
                                </span>
                                <span class="badge bg-secondary">
                                    Taux <field name="occupancy_rate" widget="percentage"/>
                                </span>
                            </div>
                            <!-- Alerte factures en retard -->
                            <t t-if="record.overdue_bills_count.raw_value &gt; 0">
                                <div class="mt-1">
                                    <span class="badge bg-warning text-dark">
                                        <i class="fa fa-exclamation-triangle me-1"/>
                                        <field name="overdue_bills_count"/> fact. en retard
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="view_max_immo_property_search" model="ir.ui.view">
        <field name="name">max.immo.property.search</field>
        <field name="model">max.immo.property</field>
        <field name="arch" type="xml">
            <search string="Rechercher une propriété">
                <field name="name" string="Nom / Référence"
                       filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="city"/>
                <field name="owner_id"/>
                <field name="manager_id"/>
                <separator/>
                <filter string="Immeuble" name="type_building"
                        domain="[('property_type', '=', 'building')]"/>
                <filter string="Villa" name="type_villa"
                        domain="[('property_type', '=', 'villa')]"/>
                <filter string="Maison" name="type_house"
                        domain="[('property_type', '=', 'house')]"/>
                <separator/>
                <filter string="Avec factures en retard" name="has_overdue"
                        domain="[('overdue_bills_count', '&gt;', 0)]"/>
                <separator/>
                <filter string="Archivées" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'property_type'}"/>
                    <filter string="Ville" name="group_city"
                            context="{'group_by': 'city'}"/>
                    <filter string="Gestionnaire" name="group_manager"
                            context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="action_max_immo_property" model="ir.actions.act_window">
        <field name="name">Propriétés</field>
        <field name="res_model">max.immo.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_max_immo_property_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première propriété
            </p>
            <p>
                Ajoutez vos immeubles, villas ou maisons et configurez
                leurs pièces pour suivre les disponibilités.
            </p>
        </field>
    </record>

</odoo>
