<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard -->

    <record id="custom_view_pos_kanban" model="ir.ui.view">
        <field name="name">pos.inherited.kanban.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates/t[@t-name='card']/div[1]" position="attributes">
                <attribute name="groups">point_of_sale.group_pos_user</attribute>
            </xpath>
            <xpath expr="//kanban/templates/t[@t-name='card']/div[2]" position="attributes">
                <attribute name="groups">point_of_sale.group_pos_user</attribute>
            </xpath>
        </field>
    </record>

</odoo>
